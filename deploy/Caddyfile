myunsyeya.com {
	root * /Users/myunsyeya/janggi-review/dist
	encode zstd gzip
	# engine threads need SharedArrayBuffer -> cross-origin isolation
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
	}
	@engine path /engine/*
	header @engine Cache-Control "public, max-age=86400"
	@xsl path *.xsl
	header @xsl Content-Type "text/xsl; charset=utf-8"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /ws* {
		reverse_proxy 127.0.0.1:8787
	}
	handle {
		# one URL per page: /analysis.html -> /analysis, /index.html -> /
		redir /index.html / 301
		# the old learning pages became studies
		redir /learn /study 301
		redir /openings/* /study 301
		# studies moved to English paths (2026-10-03)
		redir /study/gwima-vs-gwima /study/edge-horse-vs-edge-horse-offset 301
		redir /study/gwima-vs-gwima/01 /study/edge-horse-vs-edge-horse-offset 301
		redir /study/gwima-vs-gwima/02 /study/edge-horse-vs-edge-horse-offset/central-cannon 301
		redir /study/gwima-vs-gwima/03 /study/edge-horse-vs-edge-horse-offset/answering-central-cannon 301
		redir /study/topic/귀마 /study/topic/edge-horse 301
		redir /study/topic/엇상 /study/topic/offset-elephants 301
		redir /study/topic/정형포진 /study/topic/standard-formation 301
		redir /study/topic/최국수포진 /study/topic/choi-guksu 301
		redir /study/topic/김경만포진 /study/topic/kim-gyeongman 301
		@html path_regexp html ^/(.+)\.html$
		redir @html /{re.html.1} 301
		# /analysis is served from the pre-rendered analysis.html
		try_files {path} {path}.html
		file_server
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
	log {
		# privacy policy (/privacy): access logs are split into files and files older than 90 days are deleted
		output file /Users/myunsyeya/Library/Logs/caddy/access.log {
			roll_size 5MiB
			roll_keep_for 90d
		}
	}
}
